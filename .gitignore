# 运行期产物：缓存/日志/会话/编译模板，285M 且随时可再生，不入库
/runtime/*

# 采集与上传的附件、图片
/upload/*

# 本地覆盖配置
.user.ini
*.log

# 编辑器与系统垃圾
.DS_Store
Thumbs.db
*.swp

# vendor/ 故意入库：本项目禁止手改 vendor，纳入版本管理后任何越界改动都会直接显现在 git status 里
# 含明文凭据的站点实配，不入库（2026-10-25 已从 git 历史中一并清除）：
#   config/database.php      → 数据库 root 口令
#   app/extra/translate.php  → 翻译服务 appid + secret
#   app/extra/maccms.php     → api_jwt_secret 及各类接口 token
# 代价：这三个文件的改动不再进历史，改之前请自行复制到 docroot 之外备份。
# 换新环境时须手工重建：install.php 会重新生成 database.php 与 maccms.php。
config/database.php
app/extra/translate.php
app/extra/maccms.php
