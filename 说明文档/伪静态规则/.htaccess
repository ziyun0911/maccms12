# ========================================================================
# maccms12 (ThinkPHP 8) - Apache rewrite rules
# 适配 maccms12：前台 index.php 为伪静态入口；admin.php/api.php/install.php
# 为真实文件，自动被 RewriteCond !-f 排除，无需额外规则。
# 站点安装在子目录时，把 RewriteBase 改为对应目录（如 /maccms12）。
#
# 下面三处 maccms:blocklist 区块是派生内容，与根目录 .htaccess 逐字节相同，
# 改名单请改 app/common/util/BlocklistRules.php 后跑 php think blocklist:sync。
# ========================================================================

# >>> maccms:blocklist:rewrite >>>
# ---- 内部目录与隐藏文件（mod_rewrite）----
<IfModule mod_rewrite.c>
    RewriteEngine On
    # 服务端专用目录：任何直接访问一律 403
    RewriteRule ^(说明文档|runtime|vendor|config|app|extend|bin)(/|$) - [F,L]
    # 隐藏文件/目录，保留 .well-known（HTTPS 证书 HTTP-01 校验要用）
    RewriteRule (^|/)\.(?!well-known) - [F,L]
</IfModule>
# <<< maccms:blocklist:rewrite <<<

# ---- 伪静态入口 ----
<IfModule mod_rewrite.c>
Options +FollowSymlinks -Multiviews
RewriteEngine on
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php?/$1 [QSA,PT,L]
</IfModule>

# >>> maccms:blocklist:files >>>
# ---- 内部后缀与根级清单文件（Apache 2.4）----
<IfModule mod_authz_core.c>
    <FilesMatch "\.(md|sql|log|lock|wpm|sh|ps1|py)$">
        Require all denied
    </FilesMatch>
    # 后缀式备份残留：.bak / .bak_cl / .bak_20261024 / .old / .orig 一律拦下
    <FilesMatch "\.(bak|old|orig)([._][A-Za-z0-9-]*)?$">
        Require all denied
    </FilesMatch>
    <FilesMatch "^(composer\.json|composer\.lock|think|\.user\.ini|router\.php)$">
        Require all denied
    </FilesMatch>
</IfModule>
# <<< maccms:blocklist:files <<<

# >>> maccms:blocklist:files-legacy >>>
# ---- 同上（Apache 2.2 回退写法）----
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(md|sql|log|lock|wpm|sh|ps1|py)$">
        Order deny,allow
        Deny from all
    </FilesMatch>
    <FilesMatch "\.(bak|old|orig)([._][A-Za-z0-9-]*)?$">
        Order deny,allow
        Deny from all
    </FilesMatch>
    <FilesMatch "^(composer\.json|composer\.lock|think|\.user\.ini|router\.php)$">
        Order deny,allow
        Deny from all
    </FilesMatch>
</IfModule>
# <<< maccms:blocklist:files-legacy <<<
