<?xml version="1.0" encoding="UTF-8"?>
<!--
  maccms12 (ThinkPHP 8) - IIS7/8/10 URL Rewrite 规则
  仅前台 index.php 走伪静态；admin.php/api.php/install.php 为真实文件，
  已通过 {REQUEST_FILENAME} IsFile/IsDirectory 判断排除。
-->
<configuration>
    <system.webServer>
        <rewrite>
		<rules>
<!-- >>> maccms:blocklist:rules >>> -->
		 <!-- 后缀式备份残留（.bak/.bak_cl/.bak_日期/.old/.orig）一律拒绝。
		      requestFiltering 的 fileExtensions 只认最后一段后缀，覆盖不了
		      x.bak_20261024 这类写法，所以用规则兜住；放在 OrgPage 之前。 -->
		 <rule name="DenyBackupFiles" stopProcessing="true">
		 <match url="(?i).*\.(bak|old|orig)([._]|$)" />
		 <action type="AbortRequest" reason="Backup file not accessible" />
		 </rule>
		 <!-- 隐藏文件/目录（保留 .well-known）：requestFiltering 的 hiddenSegments
		      匹配不到以点开头的名字，只能靠规则兜住；只拦段首是 . 的路径，
		      /.well-known/acme-challenge/xxx 这类证书校验路径照常放行。 -->
		 <rule name="DenyDotFiles" stopProcessing="true">
		 <match url="(^|/)\.(?!well-known)" />
		 <action type="AbortRequest" reason="Hidden file not accessible" />
		 </rule>
		 <!-- 根级清单文件：.lock 已被 fileExtensions 挡住，composer.json 与 think
		      没有危险后缀，router.php 是 php -S 的开发路由，逐个点名拦；
		      .json 不能整类拦，后台 Swagger 还要用 static/swagger/*.json。 -->
		 <rule name="DenyRootFiles" stopProcessing="true">
		 <match url="^(composer\.json|composer\.lock|think|\.user\.ini|router\.php)$" />
		 <action type="AbortRequest" reason="Internal file not accessible" />
		 </rule>
<!-- <<< maccms:blocklist:rules <<< -->
		 <rule name="OrgPage" stopProcessing="true">
		 <match url="^(.*)$" />
		 <conditions logicalGrouping="MatchAll">
		 <add input="{HTTP_HOST}" pattern="^(.*)$" />
		 <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
		 <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
		 </conditions>
		 <action type="Rewrite" url="index.php/{R:1}" />
		 </rule>
		 </rules>
	</rewrite>
        <!--
          访问控制：内部目录与内部后缀禁止通过 HTTP 直接下载。
          requestFiltering 是 IIS 内置功能，无需额外安装模块；
          hiddenSegments 对 URL 路径分段做大小写不敏感匹配，
          PHP 侧 require/include 读文件不走 HTTP，拦截不影响程序运行。
        -->
        <security>
            <requestFiltering>
<!-- >>> maccms:blocklist:security >>> -->
                <hiddenSegments>
                    <add segment="说明文档" />
                    <add segment="runtime" />
                    <add segment="vendor" />
                    <add segment="config" />
                    <add segment="app" />
                    <add segment="extend" />
                </hiddenSegments>
                <fileExtensions>
                    <add fileExtension=".md" allowed="false" />
                    <add fileExtension=".sql" allowed="false" />
                    <add fileExtension=".log" allowed="false" />
                    <add fileExtension=".lock" allowed="false" />
                    <add fileExtension=".wpm" allowed="false" />
                    <add fileExtension=".sh" allowed="false" />
                    <add fileExtension=".ps1" allowed="false" />
                    <add fileExtension=".py" allowed="false" />
                </fileExtensions>
<!-- <<< maccms:blocklist:security <<< -->
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
