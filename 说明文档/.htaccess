# ========================================================================
# maccms12 - 本目录（站长说明文档）禁止通过 HTTP 直接下载。
# 该文件随目录一起复制/部署，无需站点全局配置即可生效。
# 仅拦截浏览器直接请求；PHP 侧 require/include/读取不受影响。
# 要看正文不必放开本文件：登录后台 →「文档与手册」→「说明文档」。
# ========================================================================
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
